<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(@title) %> · Riggs</title>
  <style>
    :root {
      --bg: #f3efe6;
      --ink: #1c1a16;
      --muted: #5c564c;
      --line: #d4ccc0;
      --accent: #0f5c4c;
      --panel: #fffdf8;
      --warn: #8a4b12;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      background:
        radial-gradient(ellipse at top left, #e8f0ec 0%, transparent 45%),
        linear-gradient(180deg, #f7f2e8 0%, var(--bg) 100%);
      color: var(--ink);
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.9rem 1.5rem;
      border-bottom: 1px solid var(--line);
      background: rgba(255,253,248,0.85);
      backdrop-filter: blur(6px);
      position: sticky;
      top: 0;
    }
    .brand { font-weight: 700; letter-spacing: 0.04em; font-size: 1.15rem; color: var(--ink); }
    nav { display: flex; flex-wrap: wrap; gap: 0.85rem; font-size: 0.92rem; }
    .who { font-size: 0.85rem; color: var(--muted); white-space: nowrap; }
    main { max-width: 960px; margin: 0 auto; padding: 1.5rem; }
    h1 { font-size: 1.6rem; margin: 0 0 0.4rem; font-family: "IBM Plex Serif", Georgia, serif; }
    h2 { font-size: 1.15rem; margin: 1.6rem 0 0.6rem; }
    p.lead { color: var(--muted); margin-top: 0; }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      padding: 1rem 1.1rem;
      margin: 1rem 0;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    th, td { text-align: left; padding: 0.45rem 0.35rem; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
    input, select, textarea, button {
      font: inherit;
      padding: 0.4rem 0.55rem;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--ink);
    }
    textarea { width: 100%; min-height: 10rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }
    button, .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      cursor: pointer;
      padding: 0.45rem 0.85rem;
      display: inline-block;
    }
    button.secondary, .btn.secondary { background: #4a453c; }
    button.danger { background: #7a2430; }
    .row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: end; margin: 0.4rem 0; }
    .row label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.8rem; color: var(--muted); }
    .flash { background: #e7f3ee; border: 1px solid #b7d8ca; padding: 0.6rem 0.8rem; margin-bottom: 1rem; }
    .muted { color: var(--muted); }
    code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }
    pre { background: #1c1a16; color: #f3efe6; padding: 0.9rem; overflow: auto; font-size: 0.82rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }
    .tile { background: var(--panel); border: 1px solid var(--line); padding: 0.9rem; }
    .tile strong { display: block; margin-bottom: 0.25rem; }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="<%= h(url('/')) %>">Riggs</a>
    <nav>
      <a href="<%= h(url('/workflows')) %>">Playbooks</a>
      <a href="<%= h(url('/triggers')) %>">Triggers</a>
      <a href="<%= h(url('/sessions')) %>">Runs</a>
      <a href="<%= h(url('/config')) %>">Config</a>
      <a href="<%= h(url('/memory')) %>">Memory</a>
      <a href="<%= h(url('/skills')) %>">Skills</a>
      <a href="<%= h(url('/login')) %>">User</a>
    </nav>
    <div class="who"><%= h(@identity[:name]) %> · <%= h(@identity[:role].to_s) %></div>
  </header>
  <main>
    <%= @content %>
  </main>
</body>
</html>
