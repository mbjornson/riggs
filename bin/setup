#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Point git at the tracked hooks directory so a fresh clone picks up the
# pre-commit gate (rubocop + rake test). Bypass one commit with --no-verify.
# Done before `bundle install` so a bundler hiccup cannot silently skip it.
if git rev-parse --git-dir >/dev/null 2>&1; then
  git config core.hooksPath .githooks
  echo "== git hooks -> .githooks (pre-commit: rubocop + rake test) =="
fi

bundle install
echo "== Riggs ready. Try: bin/riggs setup =="
