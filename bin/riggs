#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  begin
    require "bundler/setup"
  rescue LoadError
    # allow running without bundler if gem is installed
  end
  $LOAD_PATH.unshift(File.expand_path("lib", root))
  require "riggs"
  Riggs.run(ARGV)
end
